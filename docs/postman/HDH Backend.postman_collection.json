{
  "info": {
    "_postman_id": "d67c8e87-fac7-41b0-bcc6-6d4376803c34",
    "name": "HDH Backend",
    "description": "Manual tests for the protected API. Configure tokens from a test OIDC provider in the collection variables before running authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Public health (no token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health returns 200 and status UP', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Films - CRUD",
      "item": [
        {
          "name": "List films",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The list returns 200 or 204 when empty', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.test('The response body is a list', function () {",
                  "        pm.expect(pm.response.json()).to.be.an('array');",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create film",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testTitle', 'Postman test ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Creation returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const film = pm.response.json();",
                  "pm.test('The response contains an ID', function () {",
                  "    pm.expect(film.id).to.be.a('number').and.above(0);",
                  "});",
                  "pm.collectionVariables.set('filmId', String(film.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 0,\n  \"title\": \"{{testTitle}}\",\n  \"director\": \"Postman\",\n  \"year\": 2024,\n  \"audio\": \"en\",\n  \"subtitle\": \"es\",\n  \"format\": \"digital\",\n  \"downloaded\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/film"
          }
        },
        {
          "name": "Get created film",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/film/{{filmId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('The film returns 200 and its ID matches', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('filmId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created film",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{filmId}},\n  \"title\": \"{{testTitle}} updated\",\n  \"director\": \"Postman\",\n  \"year\": 2024,\n  \"audio\": \"en\",\n  \"subtitle\": \"es\",\n  \"format\": \"digital\",\n  \"downloaded\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update returns 202 and preserves the ID', function () {",
                  "    pm.response.to.have.status(202);",
                  "    pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('filmId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete created film",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/film/{{filmId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Deletion returns 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication and errors",
      "item": [
        {
          "name": "No token: expect 401 Problem Details",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 response has a Problem Details body', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid token: expect 401 Problem Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{invalidToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid token returns 401 Problem Details', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Expired token: expect 401 Problem Details",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{expiredToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expired token returns 401 Problem Details', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Nonexistent film: expect 404 Problem Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/film/9223372036854775807"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 response has a Problem Details body', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Nonexistent route: expect 404 Problem Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/not-a-route"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 response has a Problem Details body', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON: expect 400 Problem Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{"
            },
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 response has a Problem Details body', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Method not allowed: expect 405 Problem Details",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('405 response has a Problem Details body', function () {",
                  "    pm.response.to.have.status(405);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(405);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unsupported media type: expect 415 Problem Details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "film"
            },
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('415 response has a Problem Details body', function () {",
                  "    pm.response.to.have.status(415);",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "    pm.expect(pm.response.json().status).to.eql(415);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "CORS preflight from Angular",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "authorization"
              }
            ],
            "url": "{{baseUrl}}/v1/film"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CORS allows the frontend origin and Authorization', function () {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('frontendOrigin'));",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Headers').toLowerCase()).to.include('authorization');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8089"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:4200"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "not-a-valid-token"
    },
    {
      "key": "expiredToken",
      "value": ""
    },
    {
      "key": "filmId",
      "value": ""
    },
    {
      "key": "testTitle",
      "value": ""
    }
  ]
}
